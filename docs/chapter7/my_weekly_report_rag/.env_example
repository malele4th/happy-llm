# 硅基流动平台 https://cloud.siliconflow.cn/
# 可复制 ../RAG/.env 使用已有配置

OPENAI_API_KEY=your api key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 必填：周报 docx 目录
REPORT_DATA_PATH=/path/to/周报目录

# 可选配置
# INDEX_PATH=./data
# DEFAULT_AUTO_DATE=true
# EMBEDDING_MODEL=BAAI/bge-m3
# CHAT_MODEL=Qwen/Qwen2.5-32B-Instruct
# EMBEDDING_BATCH_SIZE=32
# LOG_LEVEL=INFO
# THRESHOLD_LATEST=0.35
# THRESHOLD_TIMELINE=0.28
# THRESHOLD_COMPARE=0.30
# BGE_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# Web 服务（python main.py --web）
# WEB_HOST=0.0.0.0
# WEB_PORT=1203
# WEB_ACCESS_TOKEN=设置后请求需携带 Authorization 头
